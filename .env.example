# Jerri Finance Portal has no cloud credentials or remote URL.
# The server binds to localhost by default.
JERRI_HOST=127.0.0.1
JERRI_PORT=4747
JERRI_PUBLIC_MODE=false
# Required for a public deployment behind HTTPS/Nginx.
# JERRI_AUTH_USER=admin
# JERRI_AUTH_PASSWORD=replace-with-a-long-random-password
